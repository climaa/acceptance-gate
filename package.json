{
  "name": "acceptance-gate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -o -- turbo run dev",
    "build": "dotenv -e .env -o -- turbo run build",
    "lint": "dotenv -e .env -o -- turbo run lint",
    "typecheck": "dotenv -e .env -o -- turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "test": "dotenv -e .env -o -- turbo run test",
    "sandcastle": "tsx .sandcastle/main.mts",
    "typecheck:sandcastle": "tsc --noEmit -p .sandcastle/tsconfig.json",
    "test:sandcastle": "vitest run --config vitest.sandcastle.config.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
