{
  "name": "acceptance-gate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -o -- turbo run dev",
    "build": "dotenv -e .env -o -- turbo run build",
    "lint": "dotenv -e .env -o -- turbo run lint",
    "typecheck": "dotenv -e .env -o -- turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "test": "dotenv -e .env -o -- turbo run test",
    "sandcastle": "tsx .sandcastle/main.mts",
    "typecheck:sandcastle": "tsc --noEmit -p .sandcastle/tsconfig.json",
    "test:sandcastle": "vitest run --config vitest.sandcastle.config.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.7",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
