# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
storybook-static/
*.tsbuildinfo

# Generated by Next, and generated DIFFERENTLY per command: `next dev` writes
# imports pointing at ./.next/dev/types/, `next build` and `next typegen` at
# ./.next/types/. Tracking it therefore has no correct value to commit — the two
# apps sat on opposite forms for a while and each dirtied the other's tree on the
# wrong command, and normalising them to one form (#400) only made both churn
# together. Every `next typegen`, `next dev` and `next build` recreates it, and
# `typecheck` runs typegen first, so nothing needs the committed copy: verified
# by deleting both and running typecheck and build green from a cleared
# .next/types. The route types tsc actually reads come from the
# `.next/types/**/*.ts` entry both tsconfigs already carry in `include`.
next-env.d.ts

# fallow's churn cache, rewritten as a side effect of `fallow health` — which is
# `pnpm health:check`, one of the eight required gate jobs. So the tracked copy
# was dirtied by every local gate run and by every agent that ran the gate before
# staging, and it went in as a side effect of PRs about something else. Two of
# those raced in #405/#406: the first merged, the second went CONFLICTING with
# auto-merge armed and stranded, and a binary conflict needs a human. Nothing
# reads the committed copy — every run regenerates it from git history — so, as
# with next-env.d.ts above, there was no correct value to commit. fallow writes
# `.fallow/.gitignore` containing `*`, which already covers cache.bin and
# graph-cache.bin; churn.bin predates it (#134) and tracking beat the ignore.
# Rooted and explicit here so a fresh clone is covered before fallow first runs.
/.fallow/

# turbo
.turbo/

# vercel
.vercel/

# env — never committed (but .env.example templates are documentation)
.env*
!.env.example

# local-only tooling and reports
claudedocs/
CLAUDE.local.md
coverage/
packages/ui/.visual-diff/
packages/visual-diff/.visual-diff/
# What `pnpm --filter @gate/visual-diff-ui dev` captures into. Rooted, because
# the two above are the differ's own artifact directories and this is a console
# instance's whole corpus.
/.visual-diff/

# Claude Code local state (.claude/skills/ IS committed — vendored skills are the
# only channel that reaches a Sandcastle agent, which never sees ~/.claude)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Sandcastle runtime (the orchestrator itself IS committed)
.sandcastle/.env
.sandcastle/logs/
.sandcastle/worktrees/

# os / editor
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json
.idea/
# Obsidian writes this wherever a vault is opened — including inside
# apps/blog/content/posts, which is a natural vault root for writing drafts.
.obsidian/

# The post `features/local/blog-content.feature` creates and removes again. Its
# fixture unlinks it in teardown too, so this only catches the run that crashed
# between the two — but that run would otherwise leave a fake post in the
# directory the blog serves, one `git add -A` away from being published.
apps/blog/content/posts/zz-local-lane-probe.mdx

# Turborepo
.turbo
