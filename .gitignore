# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
storybook-static/
*.tsbuildinfo

# turbo
.turbo/

# vercel
.vercel/

# env — never committed (but .env.example templates are documentation)
.env*
!.env.example

# local-only tooling and reports
claudedocs/
CLAUDE.local.md
coverage/
packages/ui/.visual-diff/
packages/visual-diff/.visual-diff/
# What `pnpm --filter @gate/visual-diff-ui dev` captures into. Rooted, because
# the two above are the differ's own artifact directories and this is a console
# instance's whole corpus.
/.visual-diff/

# Claude Code local state (.claude/skills/ IS committed — vendored skills are the
# only channel that reaches a Sandcastle agent, which never sees ~/.claude)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Sandcastle runtime (the orchestrator itself IS committed)
.sandcastle/.env
.sandcastle/logs/
.sandcastle/worktrees/

# os / editor
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json
.idea/
# Obsidian writes this wherever a vault is opened — including inside
# apps/blog/content/posts, which is a natural vault root for writing drafts.
.obsidian/

# The post `features/local/blog-content.feature` creates and removes again. Its
# fixture unlinks it in teardown too, so this only catches the run that crashed
# between the two — but that run would otherwise leave a fake post in the
# directory the blog serves, one `git add -A` away from being published.
apps/blog/content/posts/zz-local-lane-probe.mdx

# Turborepo
.turbo
