{
  "name": "@gate/ui",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
