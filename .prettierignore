# `storybook build` output: a bundled site whose .json and .css this glob would
# otherwise reach. Prettier does not read .gitignore, so it is named twice.
storybook-static/

# Prettier 3.x rewrites MDX `{/* ... */}` comments as `{/_ ... _/}`, which is not a
# valid JS expression and breaks the MDX compile at build time. `.md` is listed too:
# `lib/posts.ts` reads either extension, drafting a post in Obsidian produces `.md`,
# and post prose is not Prettier's business whichever suffix it lands under.
apps/blog/content/**/*.mdx
apps/blog/content/**/*.md

# Vendored third-party skills, copied unmodified from vercel/next.js at a pinned
# commit. PROVENANCE.md records a SHA-256 per file, so reformatting them would
# invalidate every checksum and break the "copied unmodified" claim they rest on.
.claude/skills/

# Playwright's run artifacts, both the acceptance pair and the -local pair the
# real-data lane writes. Gitignored via apps/e2e/.gitignore, but Prettier does
# not read .gitignore, so a local run leaves files this glob would flag — the
# report's own trace-viewer .css among them.
apps/e2e/test-results*/
apps/e2e/playwright-report*/

# Committed font payload: the binaries, their OFL texts and the OG provenance
# record. The only file here `format`'s glob reaches is `og/PROVENANCE.md`, whose
# checksum table it would reflow — but an editor's format-on-save reads this file
# too, and a licence must travel byte-for-byte with the fonts it covers.
packages/ui/src/fonts/

# Generated by `next build` and marked "should not be edited". Next 16 emits
# `import "./.next/types/routes.d.ts";` with double quotes, which our single-quote
# config rewrites — and the next build rewrites straight back. Formatting it makes
# every build dirty the tree, so it is excluded instead.
apps/blog/next-env.d.ts
apps/visual-diff-ui/next-env.d.ts
