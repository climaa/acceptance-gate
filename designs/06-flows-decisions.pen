                  "type": "text",
                  "id": "d15lHp",
                  "name": "why",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "D6 still holds for a comparison: the report's design view keeps the board beside the after screenshot. A set screenshot is no comparison and carries no bucket, so a board crop laid on it judges nothing — it lets a person see the 1px drift side by side hides. The alignment is the reader's own, by hand, and the offset stays on screen.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
