                {
                  "type": "text",
                  "id": "b1Kfkw",
                  "name": "why",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A board is drawn at its own scale, in light, with padding no capture has, and every re-export drifts 0.4–2% of its pixels — blinking or diffing it against a screenshot would report differences that are not there. So it is never a side and never carries a bucket: compare to swaps the six modes out for the board beside the after screenshot, and the reviewer pans to the tile and judges by eye, the way Chromatic shows a design next to a story.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
