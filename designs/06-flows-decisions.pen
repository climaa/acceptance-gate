                },
                {
                  "type": "text",
                  "id": "tOoUa",
                  "name": "why",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The board draws three row grammars: report rows are links, history rows carry a view button, set rows are plain text with delete only. The set viewer collapses one of those, so it takes the reports-table grammar — a history row's view points at a resource other than the row's subject and needs a verb, while a set label's destination IS the set, so the identity is the link. The label links only where this instance holds the screenshots, which is the same signal that already draws an em dash in the size column: a dead link beside a live one is worse than no link. D2 is untouched — a read-only route adds no mutation and no refusal.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
