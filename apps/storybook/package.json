  },
  "dependencies": {
    "@gate/ui": "workspace:*",
    "@gate/visual-diff": "workspace:*",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@gate/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "10.5.10",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.0",
    "remark-gfm": "^4.0.1",
    "storybook": "10.5.7",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
