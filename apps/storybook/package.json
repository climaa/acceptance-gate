{
  "name": "@gate/storybook",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir storybook-static",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "health": "node ../../scripts/complexity-gate.mjs",
