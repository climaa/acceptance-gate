# bddgen output — one dir per lane, regenerated on every run. The -local pair
# belongs to playwright.local.config.ts; sharing one would have each lane's
# bddgen delete the other's generated specs.
.features-gen/
.features-gen-local/

# Playwright run artifacts — the -local pair belongs to playwright.local.config.ts,
# kept separate so a real-data exploration never clobbers an acceptance run's report
playwright-report/
playwright-report-local/
test-results/
test-results-local/

# The visual-diff worlds, rebuilt by `scripts/seed-visual-diff.mjs` on every boot
.worlds/
