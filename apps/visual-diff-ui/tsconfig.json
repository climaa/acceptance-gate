{
  "extends": "@gate/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  // `types/visual-diff/*.d.ts` declares four of the differ's modules for this
  // app — see types/visual-diff/compare.d.ts for why, and for why they are
  // ambient `declare module` blocks rather than `paths` entries pointing at
  // them: Turbopack reads `paths` as runtime resolution, and a bundle built from
  // a declaration file exports nothing at all.
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
